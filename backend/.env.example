# Copy this to .env and fill in your values.
# Never commit .env to source control.

# ── Engine auth ────────────────────────────────────────────────────────────────
# Single static bearer token protecting ALL API endpoints (v1).
# Replace with a long random secret in production.
GITOPS_TOKEN=change_me_to_a_long_random_secret

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite file. Created automatically on first run.
DATABASE_URL=sqlite:./gitops.db

# ── Config ─────────────────────────────────────────────────────────────────────
# Path to stacks.yml (default: ./stacks.yml)
STACKS_CONFIG_PATH=./stacks.yml

# ── Per-stack credentials (referenced by name in stacks.yml) ───────────────────
# Personal Access Tokens
WEBAPP_PROD_PAT=ghp_...

# SSH deploy key path (absolute path to PEM file on the host)
WORKER_STAGING_SSH_KEY_PATH=/run/secrets/worker_staging_id_rsa

# ── Server ─────────────────────────────────────────────────────────────────────
# Reserved GitOps Control Plane Port 9090 (avoids 8080 conflicts with user app containers)
BIND_ADDRESS=0.0.0.0:9090

# ── Logging ────────────────────────────────────────────────────────────────────
# tracing-subscriber directive, e.g. "info", "gitops_engine=debug,sqlx=warn"
RUST_LOG=info
