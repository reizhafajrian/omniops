# Copy this to .env and fill in your values.
# Never commit .env to source control.

# ── Engine auth ────────────────────────────────────────────────────────────────
# OMNIOPS_TOKEN is no longer used. Authentication is managed via the database.
# Create a new user with:
#   omni users create admin <password>

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite file. Created automatically on first run.
DATABASE_URL=sqlite:./omniops.db

# ── Config ─────────────────────────────────────────────────────────────────────
# Path to stacks.yml (default: ./stacks.yml)
STACKS_CONFIG_PATH=./stacks.yml

# ── Per-stack credentials (referenced by name in stacks.yml) ───────────────────
# Personal Access Tokens
WEBAPP_PROD_PAT=ghp_...

# SSH deploy key path (absolute path to PEM file on the host)
WORKER_STAGING_SSH_KEY_PATH=/run/secrets/worker_staging_id_rsa

# ── Server ─────────────────────────────────────────────────────────────────────
# Reserved OmniOps Control Plane Port 9090 (avoids 8080 conflicts with user app containers)
BIND_ADDRESS=0.0.0.0:9090

# ── Logging ────────────────────────────────────────────────────────────────────
# tracing-subscriber directive, e.g. "info", "omniops_engine=debug,sqlx=warn"
RUST_LOG=info
